# ---- Servidor ----
NODE_ENV=development
PORT=4000
# Origem(ns) permitidas para CORS/CSRF (separadas por vírgula)
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/evoto.db
SESSION_TTL_HOURS=8
# Nº de proxies à frente da app (ex.: 1 atrás de Nginx/Traefik) — necessário para IP correcto no rate limit
TRUST_PROXY=0
# true = o Express serve o frontend compilado (client/dist)
SERVE_CLIENT=false

# ---- Segredos (OBRIGATÓRIOS em produção) ----
# Gere cada um com:  openssl rand -hex 32
# ATENÇÃO: perder BALLOT_ENCRYPTION_KEY torna impossível apurar os boletins cifrados.
BALLOT_ENCRYPTION_KEY=
IDENTITY_PEPPER=

# ---- Seed do administrador inicial ----
ADMIN_EMAIL=admin@evoto.local
ADMIN_PASSWORD=
